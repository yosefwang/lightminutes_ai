PORT=8787
GROQ_API_KEY=gsk_your_groq_api_key_here
ANTHROPIC_API_KEY=sk-ant_your_anthropic_key_here

# STT 模型配置 / STT Model Configuration
GROQ_STT_MODEL=whisper-large-v3
STT_LANGUAGE=zh

# LLM 模型配置 / LLM Model Configuration
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_LANGUAGE=zh

# Cloudflare R2 / S3 配置 / R2/S3 Configuration
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=lightminute-recordings
R2_PUBLIC_URL=https://your-r2-subdomain.r2.dev
